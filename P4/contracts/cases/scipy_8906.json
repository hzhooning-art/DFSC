{
  "schema": "P4-Component-Contract-v1",
  "contract_id": "scipy-solve-banded-representation-v1",
  "component": {"project": "scipy/scipy", "interface": "scipy.linalg.solve_banded", "implementation": "released wheel"},
  "domain": {"inputs": "finite real singleton band systems", "parameters": {"lower_bands": [0, 1], "upper_bands": [0, 1]}},
