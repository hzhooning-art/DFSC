    "representation_equivalence": {"layer": "property", "generator": "equivalent_band_representations", "comparator": "allclose_between_representations", "parameters": {"rtol": 1e-12, "atol": 1e-12}, "max_invocations": 4, "mechanisms": ["representation_mismatch"]},
    "version_pair": {"layer": "replay", "generator": "unchanged_runner_pair", "comparator": "paired_role_semantics", "parameters": {}, "max_invocations": 2, "mechanisms": ["historical_regression", "replay"]}
  },
  "rejection": {"incompatible_shape": "invalid_case"},
